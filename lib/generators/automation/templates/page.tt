# frozen_string_literal: true

require 'ruby_raider/runtime'
<%- if cross_platform? -%>
require_relative '../../helpers/appium_helper'
<%- end -%>
<%- if mobile? -%>
require_relative '../../helpers/gesture_helper'
<%- end -%>
<%- if network_helper? -%>
require_relative '../../helpers/network_helper'
<%- end -%>
<%- if screenshot_helper? -%>
require_relative '../../helpers/screenshot_helper'
<%- end -%>

class Page
<%- if cross_platform? -%>
  include AppiumHelper
<%- end -%>
  include Raider::Helpers
<%- if mobile? -%>
  include GestureHelper
<%- end -%>
<%- if network_helper? -%>
  include NetworkHelper
<%- end -%>
<%- if screenshot_helper? -%>
  include ScreenshotHelper
<%- end -%>

<%= partial('initialize_selector') -%>
<%= partial('visit_method') -%>
<%= partial('url_methods') -%>

  def to_s
    self.class.to_s.sub('Page', ' Page')
  end
  <%- if selenium_based? && examples? -%>

  # Elements

  def welcome_message
    driver.find_element(css: '.welcome-msg')
  end
  <%- end -%>
end
