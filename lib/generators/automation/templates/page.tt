# frozen_string_literal: true

<%- if web? && examples? -%>
require_relative '../components/header'
<%- end -%>
<%- if wait_helper? -%>
require_relative '../../helpers/wait_helper'
<%- end -%>

class Page
<%- if cross_platform? -%>
  include AppiumHelper
<%- end -%>
<%- if wait_helper? -%>
  include WaitHelper
<%- end -%>
<%- if cross_platform? || wait_helper? -%>

<%- end -%>
<%= partial('initialize_selector') -%>
<%= partial('visit_method') -%>
<%= partial('url_methods') -%>

  def to_s
    self.class.to_s.sub('Page', ' Page')
  end
  <%- if selenium_based? && examples? -%>

  # Components

  def header
    Header.new(find_element(css: '.welcome-msg'))
  end
  <%- elsif watir? -%>

  # Components

  def header
    Header.new(browser.element(css: '.welcome-msg'))
  end
  <%- end -%>
end
