<%- if web? -%>
require_relative '../components/header'
<%- end -%>
<%- if wait_helper? -%>
require_relative '../../helpers/wait_helper'
<%- end -%>

class Page
<%- if cross_platform? -%>
  include AppiumHelper
<%- end -%>
<%- if wait_helper? -%>
  include WaitHelper
<%- end -%>
<%=- partial('initialize_selector', trim: false) -%>
<%=- partial('visit_method', trim: false) -%>
<%=- partial('url_methods', trim: false) -%>

  def to_s
    self.class.to_s.sub('Page', ' Page')
  end

  <%- if selenium_based? -%>
  # Components

  def header
    Header.new(find_element(css: '.welcome-msg'))
  end
  <%- elsif watir? -%>
  # Components

  def header
    Header.new(browser.element(css: '.welcome-msg'))
  end
  <%- end -%>
end
