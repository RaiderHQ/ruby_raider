# frozen_string_literal: true

require_relative '../abstract/page'

class Home < Page
  # Actions

  def go_to_product_detail
    first_product.click
  end

  private

  # Elements

  def first_product
    <%= cross_platform? ? 'element(' : 'driver.find_element(' -%><%= partial('home_page_selector').strip -%>)
  end
end
