# frozen_string_literal: true

require 'raider_reporter/cucumber'
require 'tmpdir'

Before do
  driver.start_driver
end

After do |scenario|
  begin
    if scenario.failed?
      Dir.mktmpdir do |temp_folder|
        screenshot_path = File.join(temp_folder, 'screenshot.png')
        driver.screenshot(screenshot_path)
        RaiderReporter.attach('screenshot', screenshot_path, type: :png)
      end
    end
  ensure
    driver.quit_driver
  end
end
