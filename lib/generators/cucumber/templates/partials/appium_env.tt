# frozen_string_literal: true

require 'raider_reporter/cucumber'
require 'tmpdir'

Before do
  driver.start_driver
end

After do |scenario|
  if scenario.failed?
    Dir.mktmpdir do |temp_folder|
      screenshot_path = "#{temp_folder}/#{scenario.name}.png"
      driver.screenshot(screenshot_path)
      RaiderReporter.attach('screenshot', screenshot_path, type: :png)
    end
  end
  driver.quit_driver
end
