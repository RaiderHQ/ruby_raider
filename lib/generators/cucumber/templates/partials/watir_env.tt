# frozen_string_literal: true

require 'raider_reporter/cucumber'
require 'tmpdir'
require 'yaml'

Before do
  viewport = YAML.load_file('config/config.yml')['viewport']
  if viewport
    browser.window.resize_to(viewport['width'], viewport['height'])
  else
    browser.window.maximize
  end
end

After do |scenario|
  if scenario.failed?
    Dir.mktmpdir do |temp_folder|
      screenshot_path = "#{temp_folder}/#{scenario.name}.png"
      browser.screenshot.save(screenshot_path)
      RaiderReporter.attach('screenshot', screenshot_path, type: :png)
    end
  end
  browser.quit
end