# frozen_string_literal: true

<%- if axe_addon? && cucumber? -%>
require 'axe-rspec'
<%- end -%>
require 'rspec'
require 'raider_reporter/cucumber'
require 'tmpdir'
require 'yaml'
require_relative '../../helpers/video_helper'
<%- if trace_helper? -%>
require_relative '../../helpers/trace_helper'
<%- end -%>
require_relative '../../helpers/session_state'
<%- if examples? -%>
require_relative '../../models/user_factory'
require_relative '../../page_objects/pages/account'
require_relative '../../page_objects/pages/login'
<%- end -%>

<%- if trace_helper? -%>
# Attempts per scenario across --retry, keyed on the scenario's location, for the trace of each attempt.
TRACE_ATTEMPTS = Hash.new(0) unless defined?(TRACE_ATTEMPTS)

# Each Gherkin step becomes a group in the trace, named by its keyword and text; hook steps are not steps.
InstallPlugin do |config, _registry|
  if defined?(TraceHelper)
    begin
      ast_lookup = Cucumber::Formatter::AstLookup.new(config)
      groups = {}
      config.on_event(:test_step_started) do |event|
        next if event.test_step.hook?

        step = event.test_step
        keyword = begin
          ast_lookup.step_source(step).step.keyword.strip
        rescue StandardError
          nil
        end
        location = { file: step.location.file, line: step.location.lines.min }
        groups[step.id] = TraceHelper.active_recorder&.step_started(name: [keyword, step.text].compact.join(' '), source: location)
      rescue StandardError => e
        TraceHelper.disable!("step groups failed: #{e.message}") if defined?(TraceHelper)
      end
      config.on_event(:test_step_finished) do |event|
        next if event.test_step.hook?

        status = %i[passed failed].include?(event.result.to_sym) ? event.result.to_sym : :skipped
        error = event.result.failed? ? event.result.exception : nil
        TraceHelper.active_recorder&.step_finished(groups.delete(event.test_step.id), status: status, error: error)
      rescue StandardError => e
        TraceHelper.disable!("step groups failed: #{e.message}") if defined?(TraceHelper)
      end
    rescue StandardError => e
      TraceHelper.warn_once("Gherkin step groups unavailable: #{e.message}")
    end
  end
end

<%- end -%>
Before do<%= trace_helper? ? ' |scenario|' : '' %>
  viewport = YAML.load_file('config/config.yml')['viewport']
  if viewport
    driver.manage.window.resize_to(viewport['width'], viewport['height'])
  else
    driver.manage.window.maximize
  end
  @video_recorder = VideoHelper.recorder_for(driver)
  @video_recorder.start
<%- if screenshot_helper? -%>
  ScreenshotHelper.reset
<%- end -%>
<%- if trace_helper? -%>
  if defined?(TraceHelper)
    @trace_attempt = (TRACE_ATTEMPTS[scenario.location.to_s] += 1)
    @trace_test = { identifier: scenario.location.to_s, full_name: scenario.name, attempt: @trace_attempt }
    @trace_recorder = TraceHelper.recorder_for(driver)
    @trace_recorder.start
  end
<%- end -%>
end

<%- if examples? -%>
Before('@logged_in') do
  user = UserFactory.for('registered user')
  account = Account.new(driver)
  SessionState.new(driver).reuse(
    valid: -> { account.tap(&:visit).header.customer_name == "Welcome back #{user['name']}" }
  ) do
    login = Login.new(driver)
    login.visit
    login.login(user['username'], user['password'])
  end
end

<%- end -%>
<%- failed_ref = network_helper? ? 'failed' : 'scenario.failed?' -%>
<%- error_ref = network_helper? ? 'error' : 'scenario.exception' -%>
After do |scenario|
<%- if network_helper? -%>
  mock_error = NetworkHelper.finish(driver) if defined?(NetworkHelper)
  failed = scenario.failed? || !mock_error.nil?
  error = scenario.exception || mock_error
<%- end -%>
<%- if trace_helper? -%>
  if defined?(TraceHelper)
    keep_trace = TraceHelper.keep_all? || <%= failed_ref %>
    trace_test = @trace_test&.merge(status: <%= failed_ref %> ? 'failed' : 'passed', error: <%= error_ref %>)
    trace_path = @trace_recorder&.stop(keep: keep_trace, test: trace_test)
  end
<%- end -%>
  video_path = @video_recorder&.stop(keep: <%= failed_ref %>)
  RaiderReporter.attach('video', video_path, type: :webm) if video_path
<%- if trace_helper? -%>
  RaiderReporter.attach('trace', trace_path, type: :trace, attempt: @trace_attempt) if trace_path
<%- end -%>
  if <%= failed_ref %>
    Dir.mktmpdir do |temp_folder|
      screenshot_path = File.join(temp_folder, 'screenshot.png')
      driver.save_screenshot(screenshot_path)
      RaiderReporter.attach('screenshot', screenshot_path, type: :png)
    end
  end
ensure
<%- if trace_helper? -%>
  @trace_recorder&.cleanup
<%- end -%>
  @video_recorder&.cleanup
  driver.quit
<%- if network_helper? -%>
  raise mock_error if mock_error
<%- end -%>
end
