# frozen_string_literal: true

<%- if axe_addon? && cucumber? -%>
require 'axe-rspec'
<%- end -%>
require 'rspec'
require 'raider_reporter/cucumber'
require 'tmpdir'
require 'yaml'
require_relative '../../helpers/video_helper'

Before do
  viewport = YAML.load_file('config/config.yml')['viewport']
  if viewport
    driver.manage.window.resize_to(viewport['width'], viewport['height'])
  else
    driver.manage.window.maximize
  end
  @video_recorder = VideoHelper.recorder_for(driver)
  @video_recorder.start
end

After do |scenario|
  video_path = @video_recorder&.stop(keep: scenario.failed?)
  RaiderReporter.attach('video', video_path, type: :webm) if video_path
  if scenario.failed?
    Dir.mktmpdir do |temp_folder|
      screenshot_path = File.join(temp_folder, 'screenshot.png')
      driver.save_screenshot(screenshot_path)
      RaiderReporter.attach('screenshot', screenshot_path, type: :png)
    end
  end
ensure
  @video_recorder&.cleanup
  driver.quit
end
