# frozen_string_literal: true

require 'English'
require 'fileutils'
require 'json'
require 'time'
require 'tmpdir'

# One run of a flow: a per-flow lock, a results folder and one line in .raider/flows/<name>/runs.jsonl.
# flows/flow_helper.rb starts it, so `raider flow run`, plain rspec, the desktop app and a schedule all
# leave the same record. Generated by `raider flow init`.
module RaiderFlows
  module Run
    NAME = /\A[a-z0-9_]{1,60}\z/.freeze
    RESERVED = %w[env].freeze # .raider/flows/env is the secrets file, not a flow's log folder
    INPUT = /\A[a-z][a-z0-9_]{0,39}\z/.freeze
    ENV_KEY = /\A[A-Z_][A-Z0-9_]*\z/.freeze
    RUN_ID = /\A[0-9a-f]{16}\z/.freeze
    RESULTS_STAMP = /\A\d{8}T\d{6}Z(?:-\d+)?\z/.freeze
    TRIGGERS = %w[manual schedule desktop].freeze
    KEEP_LINES = 50
    KEEP_RESULTS = 20
    MAX_RUN_JSON_BYTES = 10 * 1024 * 1024
    MAX_ENV_BYTES = 64 * 1024
    MIN_SECRET = 4
    ENV_FILE = '.raider/flows/env'
    NOFOLLOW = defined?(File::NOFOLLOW) ? File::NOFOLLOW : 0
    NONBLOCK = defined?(File::NONBLOCK) ? File::NONBLOCK : 0
    ROOT = File.expand_path('../..', __dir__)

    class << self
      attr_reader :name, :results_dir

      # At require time, before the driver or the reporter start. Exits 3 when the flow is already running.
      def start!
        # `rspec --dry-run` runs nothing, so it takes no lock and leaves no record
        return if @name || RSpec.configuration.dry_run?

        root = File.realpath(ROOT)
        @name = flow_name
        @root = root
        @started_at = now
        @secrets = []
        busy! unless lock
        stop_on_interrupt
        # Registered as soon as the lock is held, so even a failure below leaves its line. It runs after
        # RSpec and the reporter finished (run.json is written), whatever way the run ended.
        at_exit { finish!(exit_status($ERROR_INFO)) }
        @results_dir = new_results_dir
        load_env_file
        headless
      end

      # RSpec would finish the whole flow on a first Ctrl-C and exit! (no run log line) on a second. The first
      # one ends the current step instead, so the run is recorded and spec_helper still quits the driver;
      # repeats are ignored while that happens.
      def stop_on_interrupt
        trap('INT') do
          next if @stopping

          @stopping = true
          raise Interrupt, 'flow stopped'
        end
      end

      # RAIDER_FLOW_HEADED=1 drops a HEADLESS left in the shell; config.yml headless: true still wins
      def headless
        if ENV['RAIDER_FLOW_HEADED'] == '1'
          ENV.delete('HEADLESS')
        else
          ENV['HEADLESS'] ||= 'true'
        end
      end

      # Flow results go to flow-results/<name>/<UTC stamp>, never raider-results, and are never cleaned
      def configure_reporter
        return unless defined?(RaiderReporter)

        RaiderReporter.configure do |reporter|
          reporter.output_dir = results_dir || (@fallback_dir ||= Dir.mktmpdir('raider-flow-'))
          reporter.clean_output_dir = false
        end
      end

      def steps_started!
        @steps_started = true
      end

      def finish!(code)
        return unless @lock

        append(record(code))
        prune
      rescue StandardError => e
        say("could not write the run log: #{e.class}")
      ensure
        release
      end

      private

      def now
        Time.now.utc
      end

      def say(message)
        $stderr.puts("[raider flow] #{message}") # rubocop:disable Style/StderrPuts -- -W0 must not hide these
      end

      def flow_name
        flows = RSpec.configuration.files_to_run.select { |file| file.end_with?('_flow.rb') }
        raise ArgumentError, 'run one flow at a time: rspec flows/<name>_flow.rb' unless flows.one?

        name = File.basename(flows.first, '_flow.rb')
        raise ArgumentError, "invalid flow name #{name.inspect}" unless NAME.match?(name) && !RESERVED.include?(name)

        wanted = ENV.fetch('RAIDER_FLOW_NAME', name)
        raise ArgumentError, "RAIDER_FLOW_NAME is #{wanted.inspect} but the flow is #{name.inspect}" unless wanted == name

        name
      end

      def lock
        file = File.join(private_dir('.raider/flows'), "#{name}.lock")
        handle = File.open(file, File::RDWR | File::CREAT | NOFOLLOW, 0o600)
        return @lock = handle if handle.flock(File::LOCK_EX | File::LOCK_NB)

        handle.close
        nil
      end

      def release
        @lock&.close
        @lock = nil
      end

      def busy!
        append(base_line.merge(finished_at: iso(now), status: 'busy', results_dir: nil))
        say("#{name} is already running")
        exit 3
      end

      # A 0700 folder inside the project that is not a link
      def private_dir(relative)
        dir = File.join(@root, relative)
        FileUtils.mkdir_p(dir)
        raise IOError, "#{relative} must be a folder, not a link" unless File.lstat(dir).directory?

        File.chmod(0o700, dir)
        dir
      end

      def new_results_dir
        base = File.join(@root, 'flow-results', name, now.strftime('%Y%m%dT%H%M%SZ'))
        dir = base
        suffix = 1
        dir = "#{base}-#{suffix += 1}" while File.exist?(dir)
        FileUtils.mkdir_p(dir)
        dir
      end

      # KEY=value lines, # comments, no interpolation. Loaded only from a regular file you own with mode 600.
      # RAIDER_FLOW_* keys are the wrapper's, so the file can't set them.
      def load_env_file
        content = read_env_file
        return unless content

        content.each_line.with_index(1) do |raw, number|
          line = raw.dup.force_encoding(Encoding::UTF_8)
          line = line.valid_encoding? ? line.strip : nil
          next if line&.empty? || line&.start_with?('#')

          key, value = line&.split('=', 2)&.map(&:strip)
          unless value && ENV_KEY.match?(key.to_s) && !key.to_s.start_with?('RAIDER_FLOW_')
            say("#{ENV_FILE} line #{number} ignored: expected KEY=value")
            next
          end
          set_env(key.to_s, unquote(value))
        end
      end

      def read_env_file
        File.open(File.join(@root, ENV_FILE), File::RDONLY | NONBLOCK | NOFOLLOW) do |file|
          stat = file.stat
          return say("ignored #{ENV_FILE}: it must be a regular file you own") unless owned_file?(stat)
          return say("ignored #{ENV_FILE}: permissions must be 600") unless private_mode?(stat)

          file.read(MAX_ENV_BYTES).to_s
        end
      rescue Errno::ENOENT
        nil
      rescue SystemCallError
        say("ignored #{ENV_FILE}: it must be a regular file you own")
      end

      # Windows has no POSIX owner or mode bits, so there the folder's ACLs decide who can read the file:
      # keep the project under your user profile, or restrict the file with icacls
      def owned_file?(stat)
        stat.file? && (Gem.win_platform? || stat.uid == Process.uid)
      end

      def private_mode?(stat)
        Gem.win_platform? || (stat.mode & 0o077).zero?
      end

      # A value already in the environment wins; both are kept out of the run log
      def set_env(key, value)
        ENV[key] = value unless ENV.key?(key)
        [value, ENV.fetch(key)].each { |secret| @secrets << secret if secret.length >= MIN_SECRET }
      end

      def unquote(value)
        quoted = value.length >= 2 && value[0] == value[-1] && ['"', "'"].include?(value[0])
        quoted ? value[1...-1].to_s : value
      end

      def exit_status(error)
        case error
        when nil then 0
        when SystemExit then error.status
        else 1
        end
      end

      def base_line
        {
          started_at: iso(@started_at),
          attempt: [Integer(ENV.fetch('RAIDER_FLOW_ATTEMPT', '1'), 10, exception: false) || 1, 1].max,
          trigger: TRIGGERS.include?(ENV.fetch('RAIDER_FLOW_TRIGGER', nil)) ? ENV.fetch('RAIDER_FLOW_TRIGGER') : 'manual',
          run_id: RUN_ID.match?(ENV.fetch('RAIDER_FLOW_RUN_ID', '')) ? ENV.fetch('RAIDER_FLOW_RUN_ID') : nil
        }.compact
      end

      def record(code)
        status = outcome(code)
        line = base_line.merge(finished_at: iso(now), status: status, results_dir: relative(results_dir))
        line[:failed_step] = failed_step if status == 'failed'
        line
      end

      def outcome(code)
        statuses = RSpec.world.all_examples.map { |example| example.execution_result.status }
        return 'completed' if code.zero? && statuses.include?(:passed) && !statuses.include?(:failed)
        return 'failed' if @steps_started && statuses.include?(:failed)

        'setup_error'
      end

      # The first failed example: its line in the flow file and the recorded step, when the desktop's sidecar named it
      def failed_step
        example = RSpec.world.all_examples.find { |each| each.execution_result.status == :failed }
        return nil unless example

        number, title = recorded_step(example)
        { number: number, title: redact(title || example.description), line: flow_line(example) }.compact
      end

      def flow_line(example)
        file = example.metadata[:absolute_file_path].to_s
        frame = Array(example.exception&.backtrace).find { |each| each.start_with?("#{file}:") }
        frame && frame.delete_prefix("#{file}:").to_i
      end

      def recorded_step(example)
        return nil unless results_dir

        report = File.join(results_dir, 'run.json')
        return nil unless File.file?(report) && File.size(report) <= MAX_RUN_JSON_BYTES

        file = example.metadata[:file_path].to_s.delete_prefix('./')
        result = JSON.parse(File.read(report)).fetch('results', []).find do |each|
          each['file_path'] == file && each['status'] == 'failed' && each['steps'].is_a?(Hash)
        end
        index = result&.dig('steps', 'failed')
        return nil unless index.is_a?(Integer)

        [index + 1, result.dig('steps', 'items', index, 'title')]
      rescue StandardError
        nil
      end

      def redact(text)
        @secrets.uniq.sort_by { |secret| -secret.length }.reduce(text.to_s) { |result, secret| result.gsub(secret, '[secret]') }
      end

      def append(line)
        File.open(log_file, File::WRONLY | File::APPEND | File::CREAT | NOFOLLOW, 0o600) do |file|
          file.flock(File::LOCK_EX)
          file.write("#{JSON.generate(line)}\n")
        end
      end

      def prune
        File.open(log_file, File::RDWR | NOFOLLOW) do |file|
          file.flock(File::LOCK_EX)
          lines = file.read.lines
          if lines.size > KEEP_LINES
            file.rewind
            file.truncate(0)
            file.write(lines.last(KEEP_LINES).join)
          end
        end
        prune_results
      end

      # Only stamp-named folders directly under flow-results/<name>, and never this run's
      def prune_results
        dir = File.join(@root, 'flow-results', name)
        return unless File.directory?(dir) && File.realpath(dir) == dir

        runs = Dir.children(dir).select do |child|
          RESULTS_STAMP.match?(child) && File.lstat(File.join(dir, child)).directory?
        end
        old = runs.sort - runs.sort.last(KEEP_RESULTS) - [results_dir && File.basename(results_dir)]
        old.each { |child| FileUtils.rm_rf(File.join(dir, child)) }
      end

      def log_file
        File.join(private_dir(".raider/flows/#{name}"), 'runs.jsonl')
      end

      def relative(path)
        path&.delete_prefix("#{@root}/")
      end

      def iso(time)
        time.iso8601(3)
      end
    end
  end
end
