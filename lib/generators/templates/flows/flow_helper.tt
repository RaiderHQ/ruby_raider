# frozen_string_literal: true

# Every flow (flows/<name>_flow.rb) requires this file. A flow is an RSpec file without assertions:
# it completes when every step ran. Run one with `raider flow run <name>`, or `bundle exec rspec flows/<name>_flow.rb`.
# Generated by `raider flow init`.

require_relative 'support/run'

# Before the driver starts: take the flow's lock, pick its results folder, load .raider/flows/env, go headless.
RaiderFlows::Run.start!

require_relative '../helpers/spec_helper'

# Helpers available inside a flow.
module FlowHelper
  # A value passed with `raider flow run <name> --input name=value`, or the recorded default.
  def flow_input(name, default = nil)
    key = name.to_s
    raise ArgumentError, "invalid flow input name #{key.inspect}" unless RaiderFlows::Run::INPUT.match?(key)

    ENV.fetch("RAIDER_INPUT_#{key.upcase}", default)
  end
end

# Flow results go to flow-results/<name>/<UTC stamp>, never raider-results, and are never cleaned.
RaiderReporter.configure do |reporter|
  reporter.output_dir = RaiderFlows::Run.results_dir
  reporter.clean_output_dir = false
end

RSpec.configure do |config|
  config.include(FlowHelper)
  # Flows don't touch spec/examples.txt, so `rspec --only-failures` stays about tests
  config.example_status_persistence_file_path = nil
  config.define_derived_metadata(file_path: %r{/flows/[^/]+_flow\.rb\z}) { |metadata| metadata[:flow] = true }
  # Runs after spec_helper's hooks started the browser: a failure before this is a setup error, not a step
  config.append_before(:each) { RaiderFlows::Run.steps_started! }
end
