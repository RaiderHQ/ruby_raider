source 'https://rubygems.org'

gem 'activesupport'
<%- if mobile? -%>
gem 'appium_console'
gem 'appium_lib'
<%- end -%>
<%- if axe_addon? -%>
gem 'axe-core-rspec'
gem 'axe-core-selenium'
<%- end -%>
<%- if screenshot_helper? -%>
gem 'chunky_png'
<%- end -%>
gem 'parallel_split_test'
gem 'parallel_tests'
gem 'raider_reporter', '~> 1.0'
gem 'rake'
gem 'reek'
gem 'rspec'
gem 'rspec-retry'
gem 'rubocop'
gem 'rubocop-rspec'
gem 'ruby_raider', '<%= ruby_raider_version_requirement %>'
<%- if selenium_based? -%>
gem 'selenium-webdriver'
<%- end -%>
