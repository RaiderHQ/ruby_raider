platform: :ios
timeout: 10 # seconds that finds, actions and assertions wait before failing
strict: true # find_element fails when a locator matches more than one element; find_elements never does
actionability: true # actions wait until the element is ready (visible, enabled, stable, receives events; on native apps visible and enabled); force: true skips it

video:
  enabled: true
  fps: 5
  max_width: 1280
