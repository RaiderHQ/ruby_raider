browser: chrome
url: 'https://raider-test-site.onrender.com/'
timeout: 10 # seconds — used for implicit waits and max wait time
implicit_wait: 0 # seconds
explicit_wait: 10 # seconds — max wait for elements
selector_priority: [id, data-testid, css, xpath] # recorder selector order
viewport:
  width: 1920
  height: 1080

browser_arguments:
  chrome:
    - no-sandbox
    - disable-dev-shm-usage
    - ignore-certificate-errors
    - search-engine-choice-country
  firefox:
    - acceptInsecureCerts
    - no-sandbox