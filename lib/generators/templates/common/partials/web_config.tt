browser: chrome
url: 'https://raider-test-site.onrender.com/'
timeout: 10 # seconds that finds, actions and assertions wait before failing
strict: true # find_element fails when a locator matches more than one element; find_elements never does
actionability: true # actions wait until the element is ready (visible, enabled, stable, receives events; on native apps visible and enabled); force: true skips it
viewport:
  width: 1920
  height: 1080

browser_arguments:
  chrome:
    - no-sandbox
    - disable-dev-shm-usage
    - ignore-certificate-errors
    - search-engine-choice-country
  firefox:
    - acceptInsecureCerts
    - no-sandbox

video:
  enabled: true
  fps: 5
  max_width: 1280
<%- if trace_helper? -%>

trace:
  enabled: true      # capture traces; failing tests keep theirs
  max_steps: 200     # newest steps are kept; older ones lose screenshots and snapshots first
  max_mb: 20         # the zip stays under this; see Cost
<%- end -%>
<%- if screenshot_helper? -%>

screenshots:
  threshold: 0.2        # per-pixel colour difference allowed, 0 (exact) to 1
  max_diff_pixels: 0    # pixels allowed to differ
  # max_diff_ratio: 0.001  # or a share of all pixels
<%- end -%>

login_state:
  max_age: 3600 # seconds a saved login is reused before logging in again