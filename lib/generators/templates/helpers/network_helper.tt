# frozen_string_literal: true

# Mocks network requests in the browser through WebDriver BiDi (chrome, edge and firefox):
# answer a request with your own response, or block it. The mixin methods land with the router.
# BIDI=off turns BiDi off, for a grid that cannot carry the websocket.
module NetworkHelper
  # Raised when mocking cannot run: no BiDi, or a browser without it.
  class Unavailable < StandardError; end

  # Raised for a mock that cannot be set up: a bad pattern or an invalid response.
  class MockError < StandardError; end

  # Matches a request against a glob or Regexp URL and an optional HTTP method.
  # Glob: ** is any characters, * is any characters except /, everything else is literal.
  class Matcher
    def initialize(url, method: nil)
      raise ArgumentError, "url must be a String or Regexp, got #{url.class}" unless url.is_a?(String) || url.is_a?(Regexp)

      @url = url
      @method = method&.to_s&.upcase
      @regexp = url.is_a?(Regexp) ? url : glob_to_regexp(url)
    end

    def match?(url_string, http_method)
      return false if @method && @method != http_method.to_s.upcase

      @regexp.match?(url_string.to_s)
    end

    # BiDi urlPatterns narrowing the intercept to the literal parts of the glob, or nil to pause everything.
    def intercept_patterns
      return nil if @url.is_a?(Regexp)

      pattern = literal_parts.compact
      pattern.empty? ? nil : [{ type: 'pattern' }.merge(pattern)]
    end

    private

    def glob_to_regexp(glob)
      source = glob.split(/(\*\*|\*)/).map do |token|
        case token
        when '**' then '.*'
        when '*' then '[^/]*'
        else Regexp.escape(token)
        end
      end
      Regexp.new("\\A#{source.join}\\z", Regexp::MULTILINE)
    end

    # Only a glob that opens with a literal scheme://host[:port] narrows: anything else could match a
    # URL the pattern would miss. The path counts only right after such an origin.
    def literal_parts
      glob = @url.split(/[?#]/, 2).first.to_s
      scheme = glob[%r{\A([a-z][a-z0-9+.-]*)://}i, 1]
      return {} unless scheme

      hostport, path = glob.delete_prefix("#{scheme}://").split(%r{(?=/)}, 2)
      host, port = hostport.to_s.split(':', 2)
      return {} if [host, port].compact.any? { |part| part.empty? || part.include?('*') }

      { protocol: scheme.downcase, hostname: host, port: port, pathname: literal_path(path) }.compact
    end

    def literal_path(path)
      path unless path.nil? || path.include?('*')
    end
  end

  # The driver helper sets web_socket_url for these.
  BIDI_BROWSERS = %w[chrome edge firefox].freeze

  class << self
    # Follows the mocks: responds to #call(event_hash) when set. Nil by default.
    attr_accessor :observer

    def bidi_off?
      ENV['BIDI'].to_s.downcase == 'off'
    end

    # True for a browser that speaks WebDriver BiDi (Edge reports MicrosoftEdge), unless BIDI=off.
    def bidi?(browser)
      return false if bidi_off?

      name = browser.to_s.downcase.delete_prefix('microsoft')
      BIDI_BROWSERS.any? { |bidi_browser| name.start_with?(bidi_browser) }
    end
  end

  def mock_request(*)
    raise NotImplementedError, 'mock_request arrives with the router'
  end

  def block_request(*)
    raise NotImplementedError, 'block_request arrives with the router'
  end

  def remove_mock(*)
    raise NotImplementedError, 'remove_mock arrives with the router'
  end

  def clear_mocks
    raise NotImplementedError, 'clear_mocks arrives with the router'
  end
end
