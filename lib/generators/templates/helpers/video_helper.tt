# frozen_string_literal: true

require 'fileutils'
<%- unless mobile? -%>
require 'open3'
require 'selenium-webdriver'
<%- end -%>
require 'tmpdir'
require 'yaml'

# Records each test and keeps the video only when the test fails.
<%- if mobile? -%>
# Appium records the device screen natively (mp4).
<%- else -%>
# Web tests capture a page screenshot after each navigation, click and text
# change (FrameListener), plus one final frame, and only failing tests are
# encoded to WebM with the ffmpeg provisioned by the ruby_raider gem.
<%- end -%>
# Any recorder error prints one [video] warning and turns recording off for
# the rest of the run; it never raises into a test. VIDEO=off skips recording.
module VideoHelper
  DEFAULTS = { 'enabled' => true, 'fps' => 5, 'max_width' => 1280 }.freeze
<%- unless mobile? -%>
  MAX_FRAME_SECONDS = 2.0
  ENCODE_TIMEOUT = 120
<%- end -%>

  @disabled = false
  @warned = false
<%- unless mobile? -%>
  @active_recorder = nil
<%- end -%>

  class << self
<%- unless mobile? -%>
    attr_accessor :active_recorder

<%- end -%>
    def config
      @config ||= DEFAULTS.merge(video_config)
    end

    def enabled?
      config['enabled'] != false && ENV['VIDEO'] != 'off' && !@disabled
    end

    def recorder_for(driver_or_browser)
      return NullRecorder.new unless enabled?

<%- if mobile? -%>
      AppiumRecorder.new(driver_or_browser)
<%- else -%>
      FrameRecorder.new(selenium_driver(driver_or_browser))
<%- end -%>
    rescue StandardError => e
      disable!("could not create a recorder: #{e.message}")
      NullRecorder.new
    end

    # A nil reason means the cause was already reported (by RubyRaider::Ffmpeg).
    def disable!(reason = nil)
      @disabled = true
<%- unless mobile? -%>
      @active_recorder = nil
<%- end -%>
      return nil if @warned

      @warned = true
      say("#{reason}; recording disabled for this run") if reason
      nil
    end
<%- unless mobile? -%>

    # Passed to Selenium as `listener:` when the driver is created.
    def listener
      return nil unless enabled?

      @listener ||= FrameListener.new
    end

    def release(recorder)
      @active_recorder = nil if @active_recorder.equal?(recorder)
    end

    def fps
      value = config['fps'].to_f
      value.positive? ? value : DEFAULTS['fps']
    end

    def max_width
      value = config['max_width'].to_i
      value.positive? ? value : DEFAULTS['max_width']
    end

    def monotonic_now
      Process.clock_gettime(Process::CLOCK_MONOTONIC)
    end

    # A screenshot while an alert is open would dismiss it, so skip that frame.
    def alert_open?(driver)
      driver.switch_to.alert
      true
    rescue Selenium::WebDriver::Error::NoSuchAlertError
      false
    end

    # frames: [[file name, monotonic time], ...] inside dir. Returns the video path or nil.
    def encode(dir, frames)
      ffmpeg = ffmpeg_path
      return nil unless ffmpeg

      list = File.join(dir, 'list.txt')
      File.write(list, concat_list(frames))
      output = File.join(dir, 'video.webm')
      ok, log = run_ffmpeg(ffmpeg_arguments(ffmpeg, list, output))
      return output if ok && File.size?(output)

      disable!("ffmpeg could not encode the video: #{log.to_s.strip.lines.last || 'no output'}")
    end
<%- end -%>

    private

    def video_config
      video = YAML.load_file('config/config.yml')['video']
      video.is_a?(Hash) ? video : {}
    rescue StandardError
      {}
    end

    # $stderr.puts, not Kernel#warn: warn is silenced under -W0.
    # rubocop:disable Style/StderrPuts
    def say(message)
      $stderr.puts("[video] #{message}")
    end
    # rubocop:enable Style/StderrPuts
<%- unless mobile? -%>

    # Watir::Browser wraps the Selenium driver.
    def selenium_driver(driver_or_browser)
      driver_or_browser.respond_to?(:wd) ? driver_or_browser.wd : driver_or_browser
    end

    def ffmpeg_path
      require 'ruby_raider/ffmpeg'
      RubyRaider::Ffmpeg.ensure! || disable!
    rescue LoadError
      disable!('ruby_raider gem too old for video; update it')
    end

    # Concat demuxer list: each frame lasts until the next one, clamped to
    # [1/fps, MAX_FRAME_SECONDS], so playback follows the test's real time.
    def concat_list(frames)
      shortest = 1.0 / fps
      lines = frames.each_with_index.flat_map do |(name, time), index|
        following = frames[index + 1]
        duration = following ? (following[1] - time).clamp(shortest, MAX_FRAME_SECONDS) : shortest
        ["file '#{name}'", format('duration %.3f', duration)]
      end
      (lines << "file '#{frames.last[0]}'").join("\n") << "\n"
    end

    def ffmpeg_arguments(ffmpeg, list, output)
      [ffmpeg, '-y', '-loglevel', 'error', '-f', 'concat', '-safe', '0', '-i', list,
       '-vf', "scale='min(#{max_width},iw)':-2", '-c:v', 'libvpx', '-deadline', 'realtime',
       '-b:v', '1M', '-r', format('%g', fps), '-pix_fmt', 'yuv420p', output]
    end

    def run_ffmpeg(arguments)
      Open3.popen2e(*arguments) do |stdin, output, process|
        stdin.close
        reader = Thread.new { output.read }
        return [process.value.success?, reader.value] if process.join(ENCODE_TIMEOUT)

        Process.kill('KILL', process.pid)
        [false, "ffmpeg timed out after #{ENCODE_TIMEOUT} seconds"]
      end
    end
<%- end -%>
  end
<%- unless mobile? -%>

  # Forwards the state-changing Selenium events to the active FrameRecorder.
  class FrameListener < Selenium::WebDriver::Support::AbstractEventListener
    def after_navigate_to(_url, driver)
      capture(driver)
    end

    def after_click(_element, driver)
      capture(driver)
    end

    def after_change_value_of(_element, driver)
      capture(driver)
    end

    private

    def capture(driver)
      VideoHelper.active_recorder&.capture(driver)
      nil
    rescue StandardError => e
      VideoHelper.disable!("frame capture failed: #{e.message}")
    end
  end

  # Saves frames to its own tmpdir; encodes them only when the test failed.
  class FrameRecorder
    attr_reader :dir

    def initialize(driver)
      @driver = driver
      @frames = []
      @recording = false
    end

    def start
      @dir = Dir.mktmpdir('raider-video')
      @frames = []
      @recording = true
      VideoHelper.active_recorder = self
      nil
    rescue StandardError => e
      VideoHelper.disable!("recording failed to start: #{e.message}")
    end

    def capture(driver = @driver)
      return nil unless @recording && VideoHelper.enabled?
      return nil if VideoHelper.alert_open?(driver)

      name = format('frame-%06d.png', @frames.size + 1)
      time = VideoHelper.monotonic_now
      driver.save_screenshot(File.join(@dir, name))
      @frames << [name, time]
      nil
    rescue StandardError => e
      VideoHelper.disable!("frame capture failed: #{e.message}")
    end

    def stop(keep:)
      return nil unless @recording

      capture if keep
      finish
      return discard unless keep && VideoHelper.enabled? && @frames.any?

      VideoHelper.encode(@dir, @frames)
    rescue StandardError => e
      finish
      VideoHelper.disable!("recording failed to stop: #{e.message}")
    end

    def cleanup
      FileUtils.rm_rf(@dir) if @dir
      nil
    rescue StandardError => e
      VideoHelper.disable!("could not remove video frames: #{e.message}")
    end

    private

    def finish
      @recording = false
      VideoHelper.release(self)
    end

    def discard
      cleanup
      nil
    end
  end
<%- else -%>

  # Appium's native screen recording; the mp4 is written as-is.
  class AppiumRecorder
    attr_reader :dir

    def initialize(driver)
      # appium_lib's Appium::Driver keeps the recording API on its core driver.
      @driver = driver.respond_to?(:start_recording_screen) ? driver : driver.driver
      @recording = false
    end

    def start
      @dir = Dir.mktmpdir('raider-video')
      @driver.start_recording_screen
      @recording = true
      nil
    rescue StandardError => e
      VideoHelper.disable!("recording failed to start: #{e.message}")
    end

    def stop(keep:)
      return nil unless @recording

      @recording = false
      video = @driver.stop_recording_screen
      return nil unless keep && VideoHelper.enabled? && video && !video.empty?

      path = File.join(@dir, 'video.mp4')
      File.binwrite(path, video.unpack1('m'))
      path
    rescue StandardError => e
      VideoHelper.disable!("recording failed to stop: #{e.message}")
    end

    def cleanup
      FileUtils.rm_rf(@dir) if @dir
      nil
    rescue StandardError => e
      VideoHelper.disable!("could not remove the video: #{e.message}")
    end
  end
<%- end -%>

  # Used when recording is off or unavailable.
  class NullRecorder
    def start
      nil
    end

    def stop(**)
      nil
    end

    def cleanup
      nil
    end
  end
end
