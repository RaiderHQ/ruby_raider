  def create_driver(*opts)
    @config = YAML.load_file('config/config.yml')
    browser = @config['browser']
    arguments = { options: create_webdriver_options(*opts) }
    listener = FanOutListener.for(listeners)
    arguments[:listener] = listener if listener
    Selenium::WebDriver.for(browser.to_sym, **arguments)
  end

  # The helpers' Selenium listeners. Deleting video_helper.rb or trace_helper.rb needs only its require.
  def listeners
    listeners = []
    listeners << VideoHelper.listener if defined?(VideoHelper)
    listeners << TraceHelper.listener if defined?(TraceHelper)
    listeners.compact
  end

  def browser_arguments(*opts)
    args = opts.empty? ? @config['browser_arguments'][@config['browser']] : opts
    args += ['--headless'] if (ENV['HEADLESS'] || @config['headless']) && !args.include?('--headless')
    args
  end

  def create_webdriver_options(*opts)
    load_browser = @config['browser'].to_s
    browser = load_browser == 'ie' ? load_browser.upcase : load_browser.capitalize
    options = "Selenium::WebDriver::#{browser}::Options".constantize.new
    browser_arguments(*opts).each { |arg| options.add_argument(arg) }
    # WebDriver BiDi carries the trace's network and console and the network mocks (chrome, edge and firefox).
    # BIDI=off turns it off for a grid that cannot carry the websocket.
    bidi = (defined?(TraceHelper) && TraceHelper.bidi?(load_browser)) ||
           (defined?(NetworkHelper) && NetworkHelper.bidi?(load_browser))
    options.web_socket_url = true if bidi
    options
  end
