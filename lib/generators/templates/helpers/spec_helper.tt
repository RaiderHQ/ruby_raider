# frozen_string_literal: true

<%- if axe_addon? -%>
require 'axe-rspec'
<%- end -%>
require 'rspec'
require 'rspec/retry'
require 'raider_reporter/rspec'
require 'tmpdir'
<%- if watir? -%>
require_relative 'browser_helper'
<%- else -%>
require_relative 'driver_helper'
<%- end -%>
require_relative 'video_helper'
<%- if wait_helper? -%>
require_relative 'wait_helper'
<%- end -%>
<%- if web? -%>
require_relative 'session_state'
<%- end -%>
<%- if web? && examples? -%>
require_relative '../models/model_factory'
require_relative '../page_objects/pages/login'
require_relative '../page_objects/pages/account'
<%- end -%>

module SpecHelper
  RSpec.configure do |config|
    config.example_status_persistence_file_path = 'spec/examples.txt'
    config.verbose_retry = true
    config.display_try_failure_messages = true
    config.default_retry_count = ENV.fetch('RETRY_COUNT', 0).to_i
    config.add_formatter(RaiderReporter::RSpec::Formatter)
    <%- if watir? -%>
    config.include(BrowserHelper)
    <%- else -%>
    config.include(DriverHelper)
    <%- end -%>
    <%- if wait_helper? -%>
    config.include(WaitHelper)
    <%- end -%>
    <%- if mobile? -%>
    config.before(:each) do
      driver.start_driver
    <%- elsif selenium_based? -%>
    config.before(:each) do
      viewport = YAML.load_file('config/config.yml')['viewport']
      if viewport
        driver.manage.window.resize_to(viewport['width'], viewport['height'])
      else
        driver.manage.window.maximize
      end
    <%- elsif watir? -%>
    config.before(:each) do
      viewport = YAML.load_file('config/config.yml')['viewport']
      if viewport
        browser.window.resize_to(viewport['width'], viewport['height'])
      else
        browser.window.maximize
      end
    <%- end -%>
      @video_recorder = VideoHelper.recorder_for(<%= watir? ? 'browser' : 'driver' %>)
      @video_recorder.start
    end
<%- if web? && examples? -%>

    config.before(:each, :logged_in) do
      user = ModelFactory.for('users')['registered user']
      account = Account.new(<%= watir? ? 'browser' : 'driver' %>)
      SessionState.new(<%= watir? ? 'browser.driver' : 'driver' %>).reuse(
        valid: -> { account.tap(&:visit).header.customer_name == "Welcome back #{user['name']}" }
      ) do
        login = Login.new(<%= watir? ? 'browser' : 'driver' %>)
        login.visit
        login.login(user['username'], user['password'])
      end
    end
<%- end -%>

    config.after(:each) do |example|
      example_name = example.description
      keep_video = example.exception ? VideoHelper.final_attempt?(example) : false
      video_path = @video_recorder&.stop(keep: keep_video)
      if example.exception
        @_exception = example.exception
        Dir.mktmpdir do |temp_folder|
          screenshot_path = "#{temp_folder}/#{example_name}.png"
          <%= partial('screenshot', strip: true) %>
          RaiderReporter.attach('screenshot', screenshot_path, type: :png)
        end
      end
      RaiderReporter.attach('video', video_path, type: <%= mobile? ? ':mp4' : ':webm' %>) if video_path
    ensure
      @video_recorder&.cleanup
      <%= partial('quit_driver', strip: true) %>
    end
  end
end
