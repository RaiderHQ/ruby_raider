name: Rspec Tests
on:
  push:
    branches: [ main, master ]
  pull_request:
  workflow_dispatch:
    inputs:
      browser:
        type: choice
        description: Which browser to test
        required: false
        default: chrome
        options:
          - chrome
      tags:
        type: string
        description: "RSpec tags to run, separated by commas or spaces, for example smoke or ~slow. Leave blank to run all tests."
        required: false
        default: ''

jobs:
  build:
    name: CI
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Ruby
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: 3.4.0
          bundler-cache: true

      - name: Set up Chrome
        uses: browser-actions/setup-chrome@v1
        with:
          chrome-version: stable

      - name: Cache ffmpeg for failure videos
        uses: actions/cache@v4
        with:
          path: ~/.cache/raider
          key: raider-ffmpeg-<%= RubyRaider::Ffmpeg::MANIFEST[:version] %>-${{ runner.os }}-${{ hashFiles('**/Gemfile.lock') }}

      - name: Install ffmpeg for failure videos
        run: bundle exec raider u video install
        # Video is optional: a failed download is visible here but never fails the build.
        continue-on-error: true

      - name: Run tests
        shell: bash
        # TAGS comes from the tags input through env only, and each tag is checked before rspec starts.
        run: |
          tag_args=()
          value_re='^[A-Za-z0-9@_:,.~! -]{0,200}$'
          tag_re='^[~!]?@?[A-Za-z0-9_][A-Za-z0-9_:.-]{0,99}$'
          if [[ ! "$TAGS" =~ $value_re ]]; then
            echo "::error::The tags input may only hold letters, digits, @ _ : , . ~ ! - and spaces (200 at most)."
            exit 2
          fi
          read -r -a tags <<< "${TAGS//,/ }"
          for tag in "${tags[@]}"; do
            if [[ ! "$tag" =~ $tag_re ]]; then
              echo "::error::Not a tag: ${tag}. Use letters, digits, _ : . -, an optional @, and ~ in front to exclude."
              exit 2
            fi
            if [[ "$tag" == '!'* ]]; then tag="~${tag:1}"; fi
            tag_args+=(--tag "$tag")
          done
          bundle exec raider-reporter exec -- bundle exec rspec spec --format documentation "${tag_args[@]}"
        # RAIDER_ENDPOINT: your Raider Hideout URL (repository variable); RAIDER_TOKEN: a project token (secret).
        env:
          TAGS: ${{ inputs.tags }}
          HEADLESS: true
          RAIDER_TOKEN: ${{ secrets.RAIDER_TOKEN }}
          RAIDER_ENDPOINT: ${{ vars.RAIDER_ENDPOINT }}
          RAIDER_QUARANTINE: "1"

      - name: Upload Raider results
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: raider-results
          path: raider-results/
          if-no-files-found: ignore

  raider-comment:
    needs: [build, raider-gate]
    if: always() && github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
      statuses: write
    steps:
      - uses: actions/checkout@v4
      - uses: ruby/setup-ruby@v1
        with: { ruby-version: 3.4.0, bundler-cache: true }
      - name: Comment Raider results on the pull request
        run: bundle exec raider-reporter comment
        env:
          RAIDER_TOKEN: ${{ secrets.RAIDER_TOKEN }}
          RAIDER_ENDPOINT: ${{ vars.RAIDER_ENDPOINT }}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  raider-gate:
    needs: [build]
    if: always() && vars.RAIDER_GATE == '1'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      statuses: write
    steps:
      - uses: actions/checkout@v4
      - uses: ruby/setup-ruby@v1
        with: { ruby-version: 3.4.0, bundler-cache: true }
      - name: Wait for the Raider quality gate
        run: bundle exec raider-reporter gate
        env:
          RAIDER_TOKEN: ${{ secrets.RAIDER_TOKEN }}
          RAIDER_ENDPOINT: ${{ vars.RAIDER_ENDPOINT }}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
