name: Appium Tests

on:
  push:
    branches: [ main, master ]
  pull_request:
  workflow_dispatch:

jobs:
<%- if ios? || cross_platform? -%>
  ios-tests:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - uses: ruby/setup-ruby@v1
        with:
          ruby-version: 3.4.0
          bundler-cache: true

      - name: Download iOS app
        uses: dawidd6/action-download-artifact@v6
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          repo: RaiderHQ/raider_test_app
          workflow: build-ios.yml
          name: raider-test-app-ios
          path: apps/

      - name: Unzip iOS app
        run: |
          cd apps
          unzip RaiderTestApp.app.zip

      - name: Start iOS Simulator
        uses: futureware-tech/simulator-action@v3
        with:
          model: 'iPhone 15'
          os_version: '17'

      - name: Install and start Appium
        run: |
          npm install -g appium
          appium driver install xcuitest
          appium &
          sleep 5

      - name: Cache ffmpeg for failure videos
        uses: actions/cache@v4
        with:
          path: ~/.cache/raider
          key: raider-ffmpeg-<%= RubyRaider::Ffmpeg::MANIFEST[:version] %>-${{ runner.os }}-${{ hashFiles('**/Gemfile.lock') }}

      - name: Install ffmpeg for failure videos
        run: bundle exec raider u video install
        # Video is optional: a failed download is visible here but never fails the build.
        continue-on-error: true

      - name: Run tests
<%- if cucumber? -%>
        run: bundle exec raider-reporter exec -- bundle exec cucumber features/ --format pretty
<%- else -%>
        run: bundle exec raider-reporter exec -- bundle exec rspec spec/ --format documentation
<%- end -%>
        # RAIDER_ENDPOINT: your Raider Hideout URL (repository variable); RAIDER_TOKEN: a project token (secret).
        env:
          APP_PATH: ${{ github.workspace }}/apps/RaiderTestApp.app
          RAIDER_TOKEN: ${{ secrets.RAIDER_TOKEN }}
          RAIDER_ENDPOINT: ${{ vars.RAIDER_ENDPOINT }}
          RAIDER_QUARANTINE: "1"
<%- if cross_platform? -%>
          RAIDER_SHARD_INDEX: "1"
          RAIDER_SHARD_TOTAL: "2"
<%- end -%>

      - name: Upload Raider results
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: raider-results-ios
          path: raider-results/
          if-no-files-found: ignore
<%- end -%>

<%- if android? || cross_platform? -%>
  android-tests:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: ruby/setup-ruby@v1
        with:
          ruby-version: 3.4.0
          bundler-cache: true

      - name: Download Android app
        uses: dawidd6/action-download-artifact@v6
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          repo: RaiderHQ/raider_test_app
          workflow: build-android.yml
          name: raider-test-app-android
          path: apps/

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Install and start Appium
        run: |
          npm install -g appium
          appium driver install uiautomator2
          appium &
          sleep 5

      - name: Cache ffmpeg for failure videos
        uses: actions/cache@v4
        with:
          path: ~/.cache/raider
          key: raider-ffmpeg-<%= RubyRaider::Ffmpeg::MANIFEST[:version] %>-${{ runner.os }}-${{ hashFiles('**/Gemfile.lock') }}

      - name: Install ffmpeg for failure videos
        run: bundle exec raider u video install
        # Video is optional: a failed download is visible here but never fails the build.
        continue-on-error: true

      - name: Run Android Emulator and Tests
        uses: reactivecircus/android-emulator-runner@v2
        with:
          api-level: 34
          target: google_apis
          arch: x86_64
          profile: pixel_8
          script: |
<%- if cucumber? -%>
            bundle exec raider-reporter exec -- bundle exec cucumber features/ --format pretty
<%- else -%>
            bundle exec raider-reporter exec -- bundle exec rspec spec/ --format documentation
<%- end -%>
        env:
          APP_PATH: ${{ github.workspace }}/apps/app-release.apk
          RAIDER_TOKEN: ${{ secrets.RAIDER_TOKEN }}
          RAIDER_ENDPOINT: ${{ vars.RAIDER_ENDPOINT }}
          RAIDER_QUARANTINE: "1"
<%- if cross_platform? -%>
          RAIDER_SHARD_INDEX: "2"
          RAIDER_SHARD_TOTAL: "2"
<%- end -%>

      - name: Upload Raider results
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: raider-results-android
          path: raider-results/
          if-no-files-found: ignore
<%- end -%>

  raider-comment:
    needs: [<%= [('ios-tests' if ios? || cross_platform?), ('android-tests' if android? || cross_platform?)].compact.join(', ') %>, raider-gate]
    if: always() && github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
      statuses: write
    steps:
      - uses: actions/checkout@v4
      - uses: ruby/setup-ruby@v1
        with: { ruby-version: 3.4.0, bundler-cache: true }
      - name: Comment Raider results on the pull request
        run: bundle exec raider-reporter comment
        env:
          RAIDER_TOKEN: ${{ secrets.RAIDER_TOKEN }}
          RAIDER_ENDPOINT: ${{ vars.RAIDER_ENDPOINT }}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  raider-gate:
    needs: [<%= [('ios-tests' if ios? || cross_platform?), ('android-tests' if android? || cross_platform?)].compact.join(', ') %>]
    if: always() && vars.RAIDER_GATE == '1'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      statuses: write
    steps:
      - uses: actions/checkout@v4
      - uses: ruby/setup-ruby@v1
        with: { ruby-version: 3.4.0, bundler-cache: true }
      - name: Wait for the Raider quality gate
        run: bundle exec raider-reporter gate
        env:
          RAIDER_TOKEN: ${{ secrets.RAIDER_TOKEN }}
          RAIDER_ENDPOINT: ${{ vars.RAIDER_ENDPOINT }}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
