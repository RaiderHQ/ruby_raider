module Raider
  module Actionable
    def click: (?force: bool) -> untyped
    def send_keys: (*untyped keys, ?force: bool) -> untyped
    alias send_key send_keys
    def clear: (?force: bool) -> untyped
    def submit: (?force: bool) -> untyped

    private

    def raider_gate: (Observer::Run? run, Symbol action, bool force) -> untyped
  end
end
