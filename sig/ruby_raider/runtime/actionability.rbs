module Raider
  module Actionability
    CHECKS: Hash[Symbol, Array[String]]
    NATIVE_CHECKS: Hash[Symbol, Array[String]]
    PHRASES: Hash[String, String]
    SCRIPT: String
    FIRST_POLL: Hash[String, untyped]
    NOTICE: String

    def self.ensure: (untyped element, Symbol action, force: bool) -> Integer
    def self.check: (untyped element, Symbol action) -> Hash[String, untyped]?
    def self.reset_notice: () -> void

    # private singleton helpers
    def self.attached: (untyped element, bool web) -> Integer
    def self.poll: (untyped element) { () -> Hash[String, untyped]? } -> Integer
    def self.native_failure: (untyped element, Symbol action) -> Hash[String, String]?
    def self.polled: (untyped element, Symbol action) -> Hash[String, untyped]?
    def self.native_ready?: (untyped element, String name) -> bool
    def self.clock: () -> Float
    def self.not_actionable: (untyped element, Hash[String, untyped]? last, Float waited) -> NotActionable
    def self.covering: (Hash[String, untyped] last) -> Hash[Symbol, untyped]?
    def self.announce: () -> void
  end
end
