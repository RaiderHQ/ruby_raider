module Raider
  module Locator
    def self.describe: (Array[untyped] args) -> String
    def self.from_hash: (Hash[untyped, untyped] hash) -> String
    def self.role_arguments: (untyped value) -> String
    def self.plain_arguments: (untyped value) -> String
    def self.render_options: (untyped options) -> Array[String]

    def describe: (Array[untyped] args) -> String
    def from_hash: (Hash[untyped, untyped] hash) -> String
    def role_arguments: (untyped value) -> String
    def plain_arguments: (untyped value) -> String
    def render_options: (untyped options) -> Array[String]
  end

  module StrictFinder
    def find_element: (*untyped) -> Selenium::WebDriver::Element
    def find_elements: (*untyped) -> Array[Selenium::WebDriver::Element]

    private

    def single: (Array[untyped] args, bool? strict) { () -> untyped } -> Selenium::WebDriver::Element
    def single_or_nil: (Array[untyped] args, bool? strict) { () -> untyped } -> Selenium::WebDriver::Element?
    def native_or_nil: () { () -> untyped } -> untyped
    def not_found: (Array[untyped] args) -> String
  end

  module StrictFirst
    def first: (*untyped) -> Selenium::WebDriver::Element
  end
end
