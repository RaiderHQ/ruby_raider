module Raider
  module Wait
    DEADLINE_KEY: Symbol
    IMMEDIATE_KEY: Symbol

    def self.deadline: () -> Float?
    def self.immediately: [T] () { () -> T } -> T
    def self.immediate?: () -> bool
    def self.until: (?timeout: Numeric?, ?interval: Numeric) { () -> untyped } -> untyped

    # private singleton helpers
    def self.limits: (Numeric? timeout) -> [Float, Float]
    def self.within: [T] (Float limit) { () -> T } -> T
    def self.pause: (Float limit, Numeric interval) -> void
    def self.now: () -> Float
  end
end
