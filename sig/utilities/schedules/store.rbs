module RubyRaider
  module Schedules
    class Store
      FILE: String
      NOFOLLOW: Integer
      NONBLOCK: Integer

      class Removed
        attr_reader name: String
        attr_reader os_id: String

        def initialize: (String name, String os_id) -> void
      end

      @project: Project
      @schedule_class: untyped
      @dir: String
      @file: String

      def initialize: (Project project, untyped schedule_class) -> void
      def all: () -> Array[untyped]
      def find: (String name) -> untyped
      def save: (untyped schedule) -> untyped
      def writable!: () -> nil
      def delete: (String name) -> untyped

      private

      def from_entry: (untyped entry) -> untyped
      def named?: (untyped entry, String name) -> bool
      def read_entries: () -> Array[untyped]?
      def writable_entries: () -> Array[untyped]
      def read_text: () -> (String | false)?
      def write: (Array[untyped] entries) -> void
      def private_dir: () -> String
    end
  end
end
