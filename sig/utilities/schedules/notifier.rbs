module RubyRaider
  module Schedules
    class Notifier
      MAX: Integer
      TIMEOUT: Integer
      OSASCRIPT: Array[String]
      NOTIFY_SEND: Array[String]
      MARKUP: Hash[String, String]
      TOAST_SCRIPT: String
      POWERSHELL_ARGS: Array[String]

      @runner: Os::CommandRunner
      @host_os: String
      @err: IO | StringIO
      @warned: bool
      @powershell: String

      def self.powershell: () -> String

      def initialize: (?runner: Os::CommandRunner, ?host_os: String, ?err: IO | StringIO, ?powershell: String) -> void
      def notify: (String title, String message) -> bool

      private

      def clean: (untyped text) -> String
      def failed: (String reason) -> false
    end
  end
end
