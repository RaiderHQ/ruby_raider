module RubyRaider
  module Schedules
    class Project
      DRIVER_HELPER: String
      REQUIRES_RUNTIME: Regexp
      MAX_HELPER_BYTES: Integer
      NO_RUNTIME: String
      OWN_VERSION: String
      LOCKED_RAIDER: Regexp
      MAX_LOCK_BYTES: Integer

      attr_reader root: String

      def initialize: (String path) -> void
      def path: (String relative) -> String
      def check_show_browser!: () -> void
      def check_raider_version!: (?String own) -> void
      def locked_raider_version: () -> (String | :no_lock | nil)
      def runtime_driver?: () -> bool
    end
  end
end
