module RubyRaider
  module Flows
    class ScheduleStore < Schedules::Store
      DIR: String

      def initialize: (Project project) -> void
      def all: () -> Array[Schedule]
      def find: (String name) -> Schedule?
      def save: (Schedule schedule) -> Schedule
      def delete: (String name) -> (Schedule | Schedules::Store::Removed)?
    end
  end
end
