module RubyRaider
  module Flows
    class ScheduleStore
      DIR: String
      FILE: String
      NOFOLLOW: Integer
      NONBLOCK: Integer

      class Removed
        attr_reader name: String
        attr_reader os_id: String

        def initialize: (String name, String os_id) -> void
      end

      def initialize: (Project project) -> void
      def all: () -> Array[Schedule]
      def find: (String name) -> Schedule?
      def save: (Schedule schedule) -> Schedule
      def writable!: () -> nil
      def delete: (String name) -> (Schedule | Removed)?

      private

      def from_entry: (untyped entry) -> Schedule?
      def named?: (untyped entry, String name) -> bool
      def read_entries: () -> Array[untyped]?
      def writable_entries: () -> Array[untyped]
      def read_text: () -> (String | false)?
      def write: (Array[untyped] entries) -> void
      def private_dir: () -> String
    end
  end
end
