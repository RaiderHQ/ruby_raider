module RubyRaider
  module Flows
    module Os
      class CommandRunner
        MISSING: Integer
        TIMED_OUT: Integer

        class Result
          attr_reader stdout: String
          attr_reader stderr: String
          attr_reader exitstatus: Integer

          def initialize: (stdout: String, stderr: String, exitstatus: Integer) -> void
          def success?: () -> bool
        end

        def call: (*String argv, ?stdin_data: String?, ?env: Hash[String, String], ?timeout: Numeric?) -> Result

        private

        def reader: (IO io) -> Thread
        def feed: (IO stdin, String? data) -> void
        def timed_out: (String command, Numeric? timeout, untyped wait) -> Result
      end
    end
  end
end
