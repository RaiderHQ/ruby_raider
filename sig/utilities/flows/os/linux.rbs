module RubyRaider
  module Flows
    module Os
      class Linux
        @primary: Systemd | Cron
        @other: Cron?

        def self.pick: (?CommandRunner runner) -> Linux

        def initialize: (?runner: CommandRunner, ?systemd: Systemd, ?cron: Cron) -> void
        def label: () -> String
        def missed_runs_note: () -> String?
        def install: (Schedule schedule) -> true
        def remove: (String os_id) -> bool
        def present?: (String os_id) -> bool

        private

        def other_present?: (String os_id) -> bool
      end
    end
  end
end
