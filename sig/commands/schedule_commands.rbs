# Type definitions for ScheduleCommands
class ScheduleCommands < Thor
  def add: (String name, *String files) -> void
  def list: () -> void
  def remove: (String name) -> void
  def run_schedule: (String name) -> bot
  def project: () -> RubyRaider::Schedules::Project
  def scheduler: () -> RubyRaider::Schedules::Scheduler
  def stop: (RubyRaider::Schedules::Error error) -> bot
end
