# Type definitions for main RubyRaider entry point
module RubyRaider
  class Raider < Thor
    GUARDED: Array[String]

    def self.start: (?Array[String] given_args, ?Hash[Symbol, untyped] config) -> void

    def current_version: () -> String

    def new: (String project_name) -> void
    def version: () -> void

    private

    def parse_examples: (untyped value) -> bool
    def generate_from_parameters: (Hash[Symbol, untyped] params) -> void
    def merge_flags: (Hash[Symbol, untyped] params) -> void
  end
end
