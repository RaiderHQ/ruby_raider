# frozen_string_literal: true

require_relative '../components/header'

class Page
  attr_reader :browser

  def initialize(browser)
    @browser = browser
  end

  def visit(*page)
    @browser.goto full_url(page.first)
  end

  def full_url(*page)
    "#{base_url}#{url(*page).to_s.delete_prefix('/')}"
  end

  # The configured url with a trailing slash, so page paths never run into its last segment.
  def base_url
    base = YAML.load_file('config/config.yml')['url'].to_s
    return base if base.empty? || base.end_with?('/')

    "#{base}/"
  end

  def url(_page)
    raise 'Url must be defined on child pages'
  end

  def to_s
    self.class.to_s.sub('Page', ' Page')
  end

  # Components

  def header
    Header.new(browser.element(css: '.welcome-msg'))
  end
end
